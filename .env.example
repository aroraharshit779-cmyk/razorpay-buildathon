# Server Configuration
PORT=3001
NODE_ENV=development

# Google Gemini AI API Key (Get at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test Mode API Credentials (Get at https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here

# Risk Threshold Defaults
DEFAULT_RISK_SCORE_THRESHOLD=45
AUTO_BLOCK_THRESHOLD=80
STEP_UP_AUTH_THRESHOLD=35
